# Target system - GL.INET X3000 (Spitz AX)
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-x3000=y
# Custom packages baked into the image (rest pulled from local feed post-flash)
CONFIG_PACKAGE_adb=y
CONFIG_PACKAGE_qfirehose=y
CONFIG_PACKAGE_quectel-5g-tools=y
CONFIG_PACKAGE_wifi-dethrash-collector=y
# Use Go pre-installed in Dockerfile.trunk; the in-tree golang-bootstrap
# can't compile on linux/arm64 hosts.
CONFIG_GOLANG_EXTERNAL_BOOTSTRAP_ROOT="/usr/local/go"
# CONFIG_GOLANG_BUILD_BOOTSTRAP is not set
# Speedtest-go binary (Go-based) for on-device speed checks.
CONFIG_PACKAGE_speedtest-go=y
# Modem stack: ModemManager driving MBIM over PCIe MHI (mainline
# mhi_pci_generic + mhi_wwan_mbim). MM owns the data plane (connect,
# reconnect on carrier-side disconnect, RAT change, signal monitoring,
# PIN unlock); netifd's `proto modemmanager` is the bridge.
#
# We tell MM to ignore /dev/ttyUSB[0-3] via /etc/modemmanager/ignore-tty
# (consumed by a patched 25-modemmanager-tty hotplug script — see
# x3000/prepare.sh) so quectel-5g-tools keeps owning the AT port for our
# 5g-info / 5g-monitor / 5g-lock / 5g-led-bars helpers. MM drives the
# MHI control surface (/dev/wwan0at0, /dev/wwan0mbim0) which is plenty.
CONFIG_PACKAGE_kmod-mhi-bus=y
CONFIG_PACKAGE_kmod-mhi-net=y
CONFIG_PACKAGE_kmod-mhi-pci-generic=y
CONFIG_PACKAGE_kmod-mhi-wwan-ctrl=y
CONFIG_PACKAGE_kmod-mhi-wwan-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-wwan=y
CONFIG_PACKAGE_modemmanager=y
CONFIG_PACKAGE_dbus=y
CONFIG_PACKAGE_glib2=y
CONFIG_PACKAGE_luci-proto-modemmanager=y
# MM auto-pulls libmbim+libqmi via deps; keep these enabled so the proxy
# binary + mbimcli are available for diagnostics and so libmbim ABI is
# present for libmm-glib clients.
CONFIG_PACKAGE_libmbim=y
CONFIG_PACKAGE_mbim-utils=y
# Hardware enumeration tools (lspci / lsusb) for diagnosing modem topology.
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
# microSD slot on the GL-X3000 is wired through an internal USB-SD
# bridge (the SoC's only MSDC controller is committed to the rootfs
# eMMC at mmc@11230000). So USB-storage + filesystems is all we need —
# no DTS work. Stock GL.iNet shipped exactly this stack.
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_block-mount=y
# Userspace tools for partitioning + mkfs on the microSD slot. Without
# these you can only mount filesystems that another machine prepared.
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
# TUN/TAP driver for OpenVPN and other tun-based VPNs. Baked in because
# kmods can't be apk-add-ed later on a custom SNAPSHOT build: the official
# kmod feed is keyed to the exact kernel vermagic/hash, which our build
# does not match. WireGuard tunnels use the in-kernel kmod-wireguard
# (pulled in by the wireguard-tools userland when needed). (#3)
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_libattr=y
CONFIG_PACKAGE_libexpat=y
CONFIG_PACKAGE_libffi=y
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_liblucihttp=y
CONFIG_PACKAGE_liblucihttp-ucode=y
CONFIG_PACKAGE_libpcre2=y
# LuCI core
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-lib-uqr=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_px5g-mbedtls=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-log=y
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PCRE2_JIT_ENABLED=y

# --- web terminal + file manager (LuCI) -----------------------------------
# ttyd serves a shell over http/websocket; luci-app-ttyd is the LuCI
# "Terminal" page that embeds it; luci-app-filemanager is a browser-based
# file browser/editor. The luci apps only need luci-base (already in). ttyd
# introduces libs the image didn't carry: it requires the FULL libwebsockets
# variant (OpenSSL + libuv event loop) -- pinned explicitly so a defconfig
# pass can't substitute the default mbedtls/none variant -- plus libcap,
# libjson-c and zlib. NB this pulls libopenssl in (the rest of the image
# leans on mbedtls), a few hundred KB.
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_libwebsockets-full=y
CONFIG_PACKAGE_libuv=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libjson-c=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_zlib=y
# Lua (needed for quectel-5g-tools + 5g-led-bars)
CONFIG_PACKAGE_lua=y
CONFIG_PACKAGE_luaposix=y
# CLI tools
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_procps-ng=y
CONFIG_PACKAGE_procps-ng-pgrep=y
CONFIG_PACKAGE_procps-ng-pkill=y
CONFIG_PACKAGE_procps-ng-ps=y
CONFIG_PACKAGE_procps-ng-w=y
CONFIG_PACKAGE_vim-full=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ethtool=y
# Kernel-panic capture is pstore/ramoops, not netconsole. The claim that this
# target has no pstore was wrong: the filogic subtarget sets CONFIG_PSTORE_RAM=y
# (target/linux/mediatek/filogic/config-6.12) and 117-complete-mt7981b-dtsi.patch
# defines ramoops@42ff0000, sized in the board DTS. With CONFIG_PANIC_ON_OOPS=y
# and CONFIG_PANIC_TIMEOUT=1 an oops still reboots in about a second, but the
# dump survives it in /sys/fs/pstore/ -- verified end to end on a real oops.
# That needs no listener and no LAN, so kmod-netconsole is dropped.
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_tmux=y
# Prometheus
CONFIG_PACKAGE_prometheus-node-exporter-lua=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-netstat=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-openwrt=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-wifi=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-wifi_stations=y
# DNS
CONFIG_PACKAGE_dnsmasq-full=y
# Wireless - add full wpad for 802.11r
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-mbedtls=y

# `src-link custom feeds-local` in feeds.conf is a build-only symlink
# feed (vjt forks pulled in by x3000/prepare.sh). Defconfig would set
# CONFIG_FEED_custom=y, which makes the apk image step template
# https://downloads.openwrt.org/releases/<v>/packages/<arch>/custom/packages.adb
# into /etc/apk/repositories.d/distfeeds.list — a URL that does not
# exist and breaks every `apk update` on the box. Pinning =m emits the
# line commented-out, so apk silently ignores it but the build infra
# still knows custom packages are selectable.
CONFIG_FEED_custom=m

# ==========================================================================
# LEAN OPTIMIZATION OVERLAY (branch `lean`, 2026-09-06) — appended after
# vjt's stock selections so these lines win on any duplicate symbol.
# Scope, and nothing else: kernel/CPU/threading, pacing, eBPF/XDP/BTF
# platform, qdisc + TCP baseline, WireGuard. The modem stack above
# (ModemManager + mainline MHI/MBIM, quectel-5g-tools with its
# 5g-watchdog) is vjt's, untouched. NO QModem, NO qosify, NO sqm. zram is
# kmod-only (module baked, no zram-swap auto-enable — added 2026-09-07).
# Companion pieces: target/linux/mediatek/patches-6.12/990-tcp-bbr3.patch
# (BBRv3), 3 lines appended to target/linux/mediatek/filogic/config-6.12
# (IKCONFIG, IKCONFIG_PROC, PREEMPT_DYNAMIC — not menu-exposed, so they
# can't live here), x3000/files-common/etc/sysctl.d/{11,20,30}-*.conf.
# Rationale + verification: x3000/docs/lean-overlay.md
# ==========================================================================
# --- eBPF / XDP / BTF kernel platform (menu-exposed KERNEL_* symbols) ---
# BTF (+modules) makes CO-RE eBPF binaries (bpftool, libbpf/xdp tools)
# run on-device; cgroup-bpf/bpf-events/kprobes/perf for tracing and
# classifier hooks; XDP sockets for AF_XDP. DEBUG_INFO is what BTF is
# derived from (REDUCED must stay off or BTF generation fails).
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_PERF_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES=y

# --- qdisc / classifier kmods (vermagic-locked: bake now or never) -----
# cake for the Phase-1 WAN shaper (hand-driven via tc — no sqm), the
# eBPF classifier hook, ifb for ingress redirection, xdp-sockets-diag
# for ss/AF_XDP introspection. fq_codel/htb/hfsc come with sched-core.
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y

# --- software flow offload (kmod = bake-now-or-never; lever-OFF) -----------
# Provides nft_flow_offload + nf_flow_table — the SOFTWARE flowtable fast
# path. Added 2026-09-07. Unlike MediaTek HW offload (PPE/WED, which can't
# touch the wwan0 MBIM path at all), the software flowtable is interface-
# agnostic and shortcuts conntrack/netfilter for established LAN<->wwan0
# flows while STILL re-transmitting through the egress qdisc, so cake keeps
# shaping. Ships INERT: firewall `flow_offloading '1'` is off by default.
# Caveat: offloaded flows skip per-packet nft rules (MSS clamp is fine — it
# acts at SYN). Prove the cake interaction with a bufferbloat run on/off
# before trusting it in production.
CONFIG_PACKAGE_kmod-nft-offload=y

# --- BBRv3 ---------------------------------------------------------------
# vjt's config.common already sets kmod-tcp-bbr=y; with the 990 patch in
# the tree that module IS BBRv3 (tcp_bbr.c 2407 lines, MODULE_VERSION 3).
# The package's own /etc/sysctl.d/12-tcp-bbr.conf keeps bbr the boot
# default, as it already is on vjt's builds. Restated here for clarity.
CONFIG_PACKAGE_kmod-tcp-bbr=y

# --- eBPF / XDP userland ---------------------------------------------------
# tc-bpf = full-feature tc + BPF loading (also carries cake_mq support,
# irrelevant on single-queue wwan0/ifb). tc-tiny stays out so /sbin/tc
# is unambiguous.
CONFIG_PACKAGE_tc-bpf=y
# CONFIG_PACKAGE_tc-tiny is not set
CONFIG_PACKAGE_libbpf=y
CONFIG_PACKAGE_bpftool-full=y
CONFIG_PACKAGE_xdp-loader=y
CONFIG_PACKAGE_xdpdump=y
# xdp-filter: high-rate XDP packet filter from the SAME xdp-tools source
# already building here (xdp-loader/xdpdump). Its only dep, libxdp, is
# already pulled by xdp-loader -- no new deps; the lever was just never set.
# (It parses an Ethernet header, so it belongs on the eth LAN/WAN ports, not
# the raw-IP wwan0 modem netdev.)
CONFIG_PACKAGE_xdp-filter=y

# --- cake-autorate prerequisites -------------------------------------------
# cake-autorate itself is a bash script dropped in post-flash (not a
# package); it needs bash + fping on the box.
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_fping=y

# --- WireGuard (kmod = bake-now-or-never; inert until a wg iface exists) --
# kmod-wireguard pulls the aarch64 NEON chacha20/poly1305 crypto in
# automatically; wireguard-tools + luci-proto-wireguard make it usable
# from CLI and LuCI with no rebuild.
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# --- zram compressed-RAM swap (present but DORMANT) -----------------------
# kmod-zram creates the /dev/zram device + compression kmods (vermagic-
# locked, must be baked in). zram-swap is the userspace init that WOULD run
# mkswap + swapon on a zram block device at boot (START=15). Added 2026-09-08
# per request but shipped DORMANT to keep this image's "capability baked,
# lever off" posture: files-common/etc/uci-defaults/99-zram-disabled runs
# `/etc/init.d/zram disable` on first boot, so swap is AVAILABLE but not
# active. Turn it on later with:
#     /etc/init.d/zram enable && /etc/init.d/zram start
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# --- Explicitly OUT of the lean image (guards; last line wins) ------------
# CONFIG_PACKAGE_qosify is not set
# CONFIG_PACKAGE_sqm-scripts is not set
# CONFIG_PACKAGE_luci-app-sqm is not set
# CONFIG_PACKAGE_ply is not set
# (No qmodem guards: that feed is not in this tree at all, so its
#  symbols don't exist here — nothing to guard against.)
