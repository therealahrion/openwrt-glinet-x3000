#!/bin/sh
# Turn zram swap on. Replaces the earlier 99-zram-disabled, which shipped the
# package present but dormant.
#
# The build already creates /etc/rc.d/S15zram on its own - default_postinst
# runs `rc.common <init> enable` whenever IPKG_INSTROOT is set, which is the
# case for anything baked into an image - so this enable is belt and braces
# for an install whose overlay carried a previous `disable`. It is marker-
# guarded so that a deliberate `/etc/init.d/zram disable` is not undone the
# next time these defaults run. See /lib/x3000/defaults.sh.
#
# uci-defaults run from /etc/init.d/boot (START=10) -> uci_apply_defaults,
# ahead of S15zram, so the service comes up normally later in this same boot.
# Nothing needs starting by hand.
#
# Compressor: lz4. It is faster than zstd at both ends, compresses better
# than plain lzo, and - unlike lzo-rle - it is one of the three values LuCI's
# System > System > ZRam Settings dropdown actually offers (lzo, lz4, zstd),
# so the field reads correctly there instead of looking unset. All four
# backends are compiled into zram.ko (see x3000/config.common), so switching
# is a uci set plus a zram restart, not a rebuild.
#
# Size: 256 MiB, half the board's 512 MB. Left unset the init would compute
# MemTotal/2048, which lands near 239 MiB because MemTotal excludes the
# kernel's reserved regions. zram allocates physical pages lazily, so this is
# a ceiling on the compressed store, not a reservation.
#
# Both are marker-guarded rather than "only if unset", so changing either in
# LuCI sticks, and so a later change to these defaults still applies to an
# install that already ran an earlier version of this script. Note the running
# zram device keeps its old settings until the next boot or an explicit
# `/etc/init.d/zram restart`, because the init only reads them at start.
. /lib/x3000/defaults.sh

[ -x /etc/init.d/zram ] || exit 0

if ! x3000_applied zram_tuning && [ -n "$(uci -q get system.@system[0])" ]; then
	uci set system.@system[0].zram_comp_algo='lz4'
	uci set system.@system[0].zram_size_mb='256'
	uci commit system
	x3000_mark zram_tuning
fi

if ! x3000_applied zram_enable; then
	/etc/init.d/zram enable
	x3000_mark zram_enable
fi
exit 0
