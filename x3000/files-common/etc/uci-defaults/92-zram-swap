#!/bin/sh
# Turn zram swap on. Replaces the earlier 99-zram-disabled, which shipped the
# package present but dormant.
#
# The build already creates /etc/rc.d/S15zram on its own - default_postinst
# runs `rc.common <init> enable` whenever IPKG_INSTROOT is set, which is the
# case for anything baked into an image - so this enable is belt and braces
# for an install whose overlay carried a previous `disable`. It is marker-
# guarded so that a deliberate `/etc/init.d/zram disable` is not undone the
# next time these defaults run. See /lib/x3000/defaults.sh.
#
# uci-defaults run from /etc/init.d/boot (START=10) -> uci_apply_defaults,
# ahead of S15zram, so the service comes up normally later in this same boot.
# Nothing needs starting by hand.
#
# Compressor: lzo-rle. /etc/init.d/zram falls back to plain "lzo" when
# system.@system[0].zram_comp_algo is unset, and lzo-rle is the strictly
# better variant of the same codec - same speed, much better on the
# zero-filled pages a router swaps out. The lz4 and zstd backends are built
# in too (see x3000/config.common), so either is one uci set plus a reboot
# away. zstd roughly doubles the compression ratio at a real CPU and swap-in
# latency cost on a 1.3 GHz A53.
#
# Size is deliberately left alone. With system.@system[0].zram_size_mb unset
# the init uses MemTotal/2048, about 235 MiB on this 512 MB board. zram
# allocates physical pages lazily, so that is a ceiling, not a reservation.
. /lib/x3000/defaults.sh

[ -x /etc/init.d/zram ] || exit 0

if [ -n "$(uci -q get system.@system[0])" ] && \
   [ -z "$(uci -q get system.@system[0].zram_comp_algo)" ]; then
	uci set system.@system[0].zram_comp_algo='lzo-rle'
	uci commit system
fi

if ! x3000_applied zram_enable; then
	/etc/init.d/zram enable
	x3000_mark zram_enable
fi
exit 0
