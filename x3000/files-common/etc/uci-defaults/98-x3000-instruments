#!/bin/sh
# Init scripts dropped in via files/ get no rc.d symlink from the image
# build, so enable them on first boot. Runs once, then uci-defaults
# deletes this script.
for s in pcie-modem-nopm boot-history; do
	[ -x "/etc/init.d/$s" ] && {
		"/etc/init.d/$s" enable
		"/etc/init.d/$s" start
	}
done
exit 0
