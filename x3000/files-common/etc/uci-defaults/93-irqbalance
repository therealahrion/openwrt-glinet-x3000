#!/bin/sh
# Turn irqbalance on.
#
# The package ships /etc/config/irqbalance with `option enabled '0'`, and its
# init script returns early unless that value is greater than zero, so
# installing irqbalance on its own does nothing whatsoever. This is the line
# that actually makes it run.
#
# Marker-guarded rather than "only if unset", because the packaged value is a
# real 0: there is no way to tell "package default" from "user turned it off",
# and a plain set would re-enable it every time these defaults run. Applying
# once per factory state is the behaviour we want. See /lib/x3000/defaults.sh.
#
# To have it off permanently, drop CONFIG_PACKAGE_irqbalance from
# x3000/config.common rather than fighting this script.
. /lib/x3000/defaults.sh

[ -f /etc/config/irqbalance ] || exit 0
x3000_applied irqbalance && exit 0

uci set irqbalance.irqbalance.enabled='1'
uci commit irqbalance
x3000_mark irqbalance
exit 0
