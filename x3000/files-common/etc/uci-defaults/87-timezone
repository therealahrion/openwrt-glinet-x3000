#!/bin/sh
# Timezone: America/Denver.
#
# Two options, both needed, because they are used by different things:
#   zonename  the human-readable name. LuCI's System > System > Timezone
#             dropdown is bound to this one, and its write handler sets both.
#   timezone  the POSIX TZ string. /etc/init.d/system writes this to /tmp/TZ,
#             and that is what actually applies on a lean image: it prefers
#             symlinking /usr/share/zoneinfo/<zonename> to /tmp/localtime, but
#             falls back to /tmp/TZ when the zoneinfo files are not installed,
#             which they are not here.
#
# The string comes from LuCI's own table (luci-lua-runtime tzdata.lua):
#     { 'America/Denver', 'MST7MDT,M3.2.0,M11.1.0' }
# MST is UTC-7, MDT starts the second Sunday in March and ends the first
# Sunday in November.
#
# No reload needed. /etc/init.d/system is also START=10, and /etc/rc.d/S10boot
# sorts before S10system, so uci-defaults have already written these by the
# time the system init reads them in the same boot.
#
# Marker-guarded: config_generate ships timezone='GMT0' and zonename='UTC', so
# those are real values and an unset test would never fire. Applied once per
# factory state, and a change made in LuCI sticks. See /lib/x3000/defaults.sh.
. /lib/x3000/defaults.sh

x3000_applied timezone && exit 0
[ -n "$(uci -q get system.@system[0])" ] || exit 0

uci set system.@system[0].zonename='America/Denver'
uci set system.@system[0].timezone='MST7MDT,M3.2.0,M11.1.0'
uci commit system
x3000_mark timezone
exit 0
