#!/bin/sh
# Field fix #1 (2026-09-05, see x3000/docs/qos-latency-research.md):
# T-Mobile 5G delivers >1472-byte downlink frames, but quectel-CM pins the
# rmnet QMAP MTU to the QMI-reported 1472, and the vendor pcie_mhi driver
# then drops every full-size packet at its skb_len>mtu gate — a silent
# downlink black hole (small traffic fine, bulk stalls). quectel-CM
# re-applies 1472 on every dial, so the override must re-assert AFTER each
# dial: ifup/ifupdate on the QModem-managed interface fires at exactly that
# point. Proven persistent across redials on hardware, 2026-09-05.
case "$ACTION" in ifup|ifupdate) ;; *) exit 0 ;; esac
[ -d /sys/class/net/rmnet_mhi0.1 ] || exit 0
cur=$(cat /sys/class/net/rmnet_mhi0.1/mtu 2>/dev/null)
[ "$cur" = "1500" ] && exit 0
ip link set dev rmnet_mhi0.1 mtu 1500
logger -t rmnet-mtu "set rmnet_mhi0.1 MTU 1500 (was $cur) after $ACTION $INTERFACE"
