From: Ahrion Gallegos <ahrionmgallegos@gmail.com>
Subject: net: wwan: mhi_wwan_mbim: deliver RX datagrams through gro_cells

The MBIM RX path hands every de-aggregated datagram to the stack with
netif_rx(): no NAPI context, no GRO. On an RM520N-GL the MHI controller
sets a 32KB MRU (mhi_quectel_rm5xx_info.mru_default), so one MHI
transfer carries an NTB of up to ~21 full-size datagrams — each of which
then walks conntrack/netfilter/IP individually. At 5G downlink rates on
a dual Cortex-A53 router that per-packet cost is the WAN bottleneck.

Switch delivery to gro_cells (net/core/gro_cells.c), the stock mechanism
for exactly this class of callback-driven virtual driver (used by
ip_tunnel, vxlan, ...): per-CPU NAPI contexts drain a small queue via
napi_gro_receive(), giving the MBIM path real NAPI instances, GRO
batching of the ~21-datagram bursts, and (as a side effect) a working
/sys/class/net/<dev>/threaded toggle. The MHI DL callback runs in
tasklet (BH) context — same context tunnels call gro_cells_receive()
from.

Details:
  * per-link gro_cells in struct mhi_mbim_link; init in newlink before
    the link is hashed (RX can look it up once hashed), destroy in
    dellink after the RCU grace period, and on register_netdevice()
    failure (which also un-hashes the stale link — previously it was
    left hashed on that error path).
  * NETIF_F_GRO is advertised and set: gro_cells_receive() falls back
    to netif_rx() when the feature bit is off, so `ethtool -K <dev>
    gro off` is a live kill-switch back to today's behaviour.
  * TX path, MBIM framing, MRU handling: untouched.

Out-of-tree patch for the GL-X3000 lean build; bench before trusting
(iperf3 downlink CPU + latency-under-load A/B, gro on vs off).

--- a/drivers/net/wwan/Kconfig
+++ b/drivers/net/wwan/Kconfig
@@ -52,6 +52,7 @@
 config MHI_WWAN_MBIM
         tristate "MHI WWAN MBIM network driver for QCOM-based PCIe modems"
         depends on MHI_BUS
+        select GRO_CELLS
         help
           MHI WWAN MBIM is a WWAN network driver for QCOM-based PCIe modems.
           It implements MBIM over MHI, for IP data aggregation and muxing.
--- a/drivers/net/wwan/mhi_wwan_mbim.c
+++ b/drivers/net/wwan/mhi_wwan_mbim.c
@@ -27,6 +27,7 @@
 #include <linux/usb/usbnet.h>
 #include <linux/usb/cdc_ncm.h>
 #include <linux/wwan.h>
+#include <net/gro_cells.h>
 
 /* 3500 allows to optimize skb allocation, the skbs will basically fit in
  * one 4K page. Large MBIM packets will simply be split over several MHI
@@ -48,6 +49,7 @@
 	struct mhi_mbim_context *mbim;
 	struct net_device *ndev;
 	unsigned int session;
+	struct gro_cells gcells;
 
 	/* stats */
 	u64_stats_t rx_packets;
@@ -344,7 +346,7 @@
 			u64_stats_add(&link->rx_bytes, skbn->len);
 			u64_stats_update_end(&link->rx_syncp);
 
-			netif_rx(skbn);
+			gro_cells_receive(&link->gcells, skbn);
 		}
 unlock:
 		rcu_read_unlock();
@@ -549,6 +551,7 @@
 {
 	struct mhi_mbim_link *link = wwan_netdev_drvpriv(ndev);
 	struct mhi_mbim_context *mbim = ctxt;
+	int err;
 
 	link->session = if_id;
 	link->mbim = mbim;
@@ -563,10 +566,21 @@
 	}
 	rcu_read_unlock();
 
+	err = gro_cells_init(&link->gcells, ndev);
+	if (err)
+		return err;
+
 	/* Already protected by RTNL lock */
 	hlist_add_head_rcu(&link->hlnode, &mbim->link_list[LINK_HASH(if_id)]);
 
-	return register_netdevice(ndev);
+	err = register_netdevice(ndev);
+	if (err) {
+		hlist_del_init_rcu(&link->hlnode);
+		synchronize_rcu();
+		gro_cells_destroy(&link->gcells);
+	}
+
+	return err;
 }
 
 static void mhi_mbim_dellink(void *ctxt, struct net_device *ndev,
@@ -577,6 +591,8 @@
 	hlist_del_init_rcu(&link->hlnode);
 	synchronize_rcu();
 
+	gro_cells_destroy(&link->gcells);
+
 	unregister_netdevice_queue(ndev, head);
 }
 
@@ -588,6 +604,8 @@
 	ndev->hard_header_len = 0;
 	ndev->addr_len = 0;
 	ndev->flags = IFF_POINTOPOINT | IFF_NOARP;
+	ndev->features |= NETIF_F_GRO;
+	ndev->hw_features |= NETIF_F_GRO;
 	ndev->netdev_ops = &mhi_mbim_ndo;
 	ndev->mtu = MHI_MBIM_DEFAULT_MTU;
 	ndev->min_mtu = ETH_MIN_MTU;
