From: Ahrion Gallegos <ahrionmgallegos@gmail.com>
Subject: net: wwan: mhi_wwan_mbim: XDP hook on the RX datagram path

Stage 2 on top of the gro_cells conversion (991): run an attached XDP
program on every de-aggregated MBIM datagram, before GRO/stack delivery.
Implements ndo_bpf (XDP_SETUP_PROG), a per-link rcu-protected prog
pointer, and NETDEV_XDP_ACT_BASIC|REDIRECT advertisement, so ip/libxdp
attach in driver mode.

The program is run through do_xdp_generic() rather than by hand. That is
deliberate and load-bearing in three separate ways.

Completeness. do_xdp_generic() implements XDP_PASS, XDP_DROP,
XDP_ABORTED, XDP_TX and XDP_REDIRECT. A module cannot implement the last
two itself: generic_xdp_tx() and xdp_do_generic_redirect() are both
private to net/core. Hand-rolling the hook therefore means refusing
XDP_REDIRECT -- and refusing XDP_REDIRECT means refusing AF_XDP, since
every `xdp-loader load` of an AF_XDP program installs libxdp's
xsk_def_prog, whose only verdict is bpf_redirect_map(). drivers/net/tun.c
makes the same call from its own driver context for the same reason.

Safety. Since 401cb7dae813 the redirect helpers read struct
bpf_redirect_info out of current->bpf_net_context, and
bpf_net_ctx_get_ri() dereferences that pointer unchecked. The core
establishes it only in net_rx_action(), napi_threaded_poll_loop(),
__napi_busy_loop(), busy_poll_stop(), sch_handle_ingress/egress(),
cpu_map_bpf_prog_run() and run_lwt_bpf(). This hook is driven from the
MHI DL tasklet, which is none of them, so a bare bpf_prog_run_xdp() here
oopsed on NULL+0x38 on the first datagram received:

  Unable to handle kernel read from unreadable memory at 0x38
  pc : xsk_map_redirect+0xc/0x90
  lr : bpf_prog_0718da224c8f0178_xsk_def_prog+0x5c/0x78
  Call trace:
    xsk_map_redirect / bpf_dispatcher_xdp_func
    mhi_process_data_event_ring [mhi] / mhi_ev_task [mhi]
    tasklet_action_common / handle_softirqs

do_xdp_generic() sets up and tears down that context itself, so the
failure mode cannot recur here.

GRO. The program is kept on link->xdp_prog, not dev->xdp_prog.
dev->xdp_prog is what netif_elide_gro() tests, and gro_cells_receive()
checks it on every datagram, falling back to netif_rx(); attaching the
same program in XDP_MODE_SKB would therefore silently switch off the GRO
991 exists to provide. Owning ndo_bpf also makes XDP_MODE_DRV the default
attach mode for this device (dev_xdp_mode()), so `ip link set dev wwan0
xdp ...` lands here rather than in the generic path.

Two ordering requirements the core imposes on the caller, both satisfied
before the program runs. bpf_prog_run_generic_xdp() computes mac_len as
skb->data - skb_mac_header(skb) and pushes that much: netdev_alloc_skb()
leaves the mac header at its ~0U sentinel, so it must be anchored first
or the arithmetic walks off the front of the buffer. And skb->protocol
must already be set, because generic_xdp_tx() and
dev_map_generic_redirect() both end in dev_queue_xmit(), which does not
re-derive it. On a raw-IP link mac_len is 0, so the program sees the IP
header at offset 0 -- programs written against an Ethernet header will
misparse silently here, reading the first two octets of the source
address as an EtherType.

XDP_PACKET_HEADROOM is reserved in front of each datagram whenever a
program is attached, so netif_skb_check_for_xdp() never has to
pskb_expand_head(). When no program is attached the cost of this hook is
one rcu_dereference per datagram.

Honest ceiling, by design: MBIM NTB aggregation means datagrams share one
32KB DMA buffer, so each is copied out before the program runs. This hook
buys the earliest available drop point and driver-context filtering, not
the zero-copy page-flip fast path XDP has on real NICs.

Out-of-tree patch for the GL-X3000 lean build; applies after 991.

--- a/drivers/net/wwan/mhi_wwan_mbim.c
+++ b/drivers/net/wwan/mhi_wwan_mbim.c
@@ -11,6 +11,7 @@
  *
  */
 
+#include <linux/bpf.h>
 #include <linux/ethtool.h>
 #include <linux/if_arp.h>
 #include <linux/if_vlan.h>
@@ -31,6 +32,7 @@
 #include <linux/wwan.h>
 #include <net/gro_cells.h>
 #include <net/ip.h>
+#include <net/xdp.h>
 
 /* 3500 allows to optimize skb allocation, the skbs will basically fit in
  * one 4K page. Large MBIM packets will simply be split over several MHI
@@ -53,6 +55,7 @@ struct mhi_mbim_link {
 	struct net_device *ndev;
 	unsigned int session;
 	struct gro_cells gcells;
+	struct bpf_prog __rcu *xdp_prog;
 
 	/* stats */
 	u64_stats_t rx_packets;
@@ -338,6 +341,106 @@ static void mhi_mbim_set_gro_hash(struct
 	skb_set_hash(skb, jhash_3words(a, b, ports, proto), PKT_HASH_TYPE_NONE);
 }
 
+/* Raw-IP link: the version nibble is the only protocol indicator. */
+static __be16 mhi_mbim_ip_proto(const struct sk_buff *skb)
+{
+	switch (skb->data[0] & 0xf0) {
+	case 0x40:
+		return htons(ETH_P_IP);
+	case 0x60:
+		return htons(ETH_P_IPV6);
+	default:
+		return 0;
+	}
+}
+
+/* Run the attached XDP program on one de-aggregated datagram.
+ *
+ * This defers to do_xdp_generic(), which is EXPORT_SYMBOL_GPL and implements
+ * the complete action set: XDP_PASS, XDP_DROP, XDP_ABORTED, XDP_TX and
+ * XDP_REDIRECT.  A module cannot implement the last two itself --
+ * generic_xdp_tx() and xdp_do_generic_redirect() are both private to
+ * net/core -- so hand-rolling the hook would mean refusing REDIRECT, which
+ * also refuses AF_XDP: every `xdp-loader load` of an AF_XDP program installs
+ * libxdp's xsk_def_prog, whose only verdict is bpf_redirect_map().
+ * drivers/net/tun.c uses this same call for its own fallback path.
+ *
+ * do_xdp_generic() also establishes its own bpf_net_context.  Since
+ * 401cb7dae813 the redirect helpers read struct bpf_redirect_info out of
+ * current->bpf_net_context and bpf_net_ctx_get_ri() dereferences it
+ * unchecked; the core sets one up only in net_rx_action(),
+ * napi_threaded_poll_loop(), __napi_busy_loop(), busy_poll_stop(),
+ * sch_handle_ingress/egress(), cpu_map_bpf_prog_run() and run_lwt_bpf().
+ * This hook runs from the MHI DL tasklet, which is none of them.
+ *
+ * The program stays on link->xdp_prog rather than dev->xdp_prog.  That
+ * distinction is load-bearing: dev->xdp_prog is what netif_elide_gro()
+ * tests, and gro_cells_receive() checks it on every datagram
+ * (net/core/gro_cells.c), so attaching in XDP_MODE_SKB instead would
+ * silently disable the GRO this driver was converted to use.
+ *
+ * Returns true when the caller should keep processing *pskb, false when it
+ * has been consumed.  *pskb may be replaced: netif_skb_check_for_xdp()
+ * reallocates when headroom is short.  It will not be here -- the RX loop
+ * reserves XDP_PACKET_HEADROOM whenever a program is attached -- but the
+ * contract is honoured regardless.
+ */
+static bool mhi_mbim_xdp_rx(struct mhi_mbim_link *link,
+			    struct bpf_prog *xdp_prog, struct sk_buff **pskb)
+{
+	struct sk_buff *skbn = *pskb;
+
+	/* bpf_prog_run_generic_xdp() computes mac_len as
+	 * skb->data - skb_mac_header(skb) and __skb_push()es that much before
+	 * running the program.  netdev_alloc_skb() leaves the mac header at
+	 * its ~0U sentinel, so it has to be anchored first or that arithmetic
+	 * walks off the front of the buffer.  Raw IP: mac_len is 0, so the
+	 * push is a no-op and the program sees the IP header at offset 0.
+	 *
+	 * protocol is needed here too, not just on the XDP_PASS path:
+	 * generic_xdp_tx() and dev_map_generic_redirect() both end in
+	 * dev_queue_xmit(), and neither re-derives it.
+	 */
+	skb_reset_network_header(skbn);
+	skb_reset_mac_header(skbn);
+	skbn->protocol = mhi_mbim_ip_proto(skbn);
+
+	if (do_xdp_generic(xdp_prog, pskb) != XDP_PASS)
+		return false;
+
+	return true;
+}
+
+/* Serialised by rtnl: ndo_bpf and ndo_uninit are both rtnl-only paths. */
+static int mhi_mbim_xdp_set(struct net_device *ndev, struct bpf_prog *prog)
+{
+	struct mhi_mbim_link *link = wwan_netdev_drvpriv(ndev);
+	struct bpf_prog *old;
+
+	old = rtnl_dereference(link->xdp_prog);
+	rcu_assign_pointer(link->xdp_prog, prog);
+	if (old)
+		bpf_prog_put(old);
+
+	return 0;
+}
+
+static int mhi_mbim_ndo_bpf(struct net_device *ndev, struct netdev_bpf *bpf)
+{
+	switch (bpf->command) {
+	case XDP_SETUP_PROG:
+		return mhi_mbim_xdp_set(ndev, bpf->prog);
+	default:
+		/* -EOPNOTSUPP, not -EINVAL: the request is well formed, this
+		 * driver simply does not implement it.  Userspace
+		 * distinguishes the two -- AF_XDP zero-copy setup probes with
+		 * XDP_SETUP_XSK_POOL and must see "unsupported", not
+		 * "malformed".
+		 */
+		return -EOPNOTSUPP;
+	}
+}
+
 static void mhi_mbim_rx(struct mhi_mbim_context *mbim, struct sk_buff *skb)
 {
 	int ndpoffset;
@@ -391,6 +494,8 @@ static void mhi_mbim_rx(struct mhi_mbim_
 		dpeoffset = ndpoffset + sizeof(struct usb_cdc_ncm_ndp16);
 		for (n = 0; n < nframes; n++, dpeoffset += sizeof(dpe16)) {
 			u16 dgram_offset, dgram_len;
+			struct bpf_prog *xdp_prog;
+			unsigned int headroom;
 			struct sk_buff *skbn;
 
 			if (skb_copy_bits(skb, dpeoffset, &dpe16, sizeof(dpe16)))
@@ -402,21 +507,30 @@ static void mhi_mbim_rx(struct mhi_mbim_
 			if (!dgram_offset || !dgram_len)
 				break; /* null terminator */
 
-			skbn = netdev_alloc_skb(link->ndev, dgram_len);
+			/* XDP programs are entitled to XDP_PACKET_HEADROOM in front
+			 * of the data for bpf_xdp_adjust_head().  Reserving it here
+			 * keeps netif_skb_check_for_xdp() from having to
+			 * pskb_expand_head() every datagram; when no program is
+			 * attached it costs nothing.
+			 */
+			xdp_prog = rcu_dereference(link->xdp_prog);
+			headroom = xdp_prog ? XDP_PACKET_HEADROOM : 0;
+
+			skbn = netdev_alloc_skb(link->ndev,
+						headroom + dgram_len);
 			if (!skbn)
 				continue;
 
+			skb_reserve(skbn, headroom);
 			skb_put(skbn, dgram_len);
 			skb_copy_bits(skb, dgram_offset, skbn->data, dgram_len);
 
-			switch (skbn->data[0] & 0xf0) {
-			case 0x40:
-				skbn->protocol = htons(ETH_P_IP);
-				break;
-			case 0x60:
-				skbn->protocol = htons(ETH_P_IPV6);
-				break;
-			default:
+			if (xdp_prog &&
+			    !mhi_mbim_xdp_rx(link, xdp_prog, &skbn))
+				continue; /* consumed: DROP/TX/REDIRECT */
+
+			skbn->protocol = mhi_mbim_ip_proto(skbn);
+			if (unlikely(!skbn->protocol)) {
 				net_err_ratelimited("%s: unknown protocol\n",
 						    link->ndev->name);
 				dev_kfree_skb_any(skbn);
@@ -656,6 +770,12 @@ static void mhi_mbim_ndo_uninit(struct n
 {
 	struct mhi_mbim_link *link = wwan_netdev_drvpriv(ndev);
 
+	/* dev_xdp_uninstall() has normally already detached the program
+	 * via ndo_bpf by the time we get here; this is belt and braces
+	 * for any path that has not, and is a no-op when the pointer is
+	 * already NULL.
+	 */
+	mhi_mbim_xdp_set(ndev, NULL);
 	gro_cells_destroy(&link->gcells);
 }
 
@@ -666,6 +786,7 @@ static const struct net_device_ops mhi_m
 	.ndo_stop = mhi_mbim_ndo_stop,
 	.ndo_start_xmit = mhi_mbim_ndo_xmit,
 	.ndo_get_stats64 = mhi_mbim_ndo_get_stats64,
+	.ndo_bpf = mhi_mbim_ndo_bpf,
 };
 
 static int mhi_mbim_newlink(void *ctxt, struct net_device *ndev, u32 if_id,
@@ -727,6 +848,13 @@ static void mhi_mbim_setup(struct net_de
 	ndev->max_mtu = MHI_MAX_BUF_SZ - ndev->needed_headroom;
 	ndev->tx_queue_len = 1000;
 	ndev->needs_free_netdev = true;
+	/* REDIRECT included: do_xdp_generic() implements it. The flag is
+	 * advisory -- dev_xdp_attach() does not enforce it -- but it is
+	 * what `ip link show` and libxdp report, and what tools use to
+	 * decide whether an AF_XDP socket can be bound here.
+	 */
+	xdp_set_features_flag(ndev, NETDEV_XDP_ACT_BASIC |
+			      NETDEV_XDP_ACT_REDIRECT);
 }
 
 static const struct wwan_ops mhi_mbim_wwan_ops = {
