+/* Run the attached XDP program on one de-aggregated datagram.
+ * Returns true if the skb should continue to the stack (XDP_PASS),
+ * false if it was consumed (dropped or reflected).
+ * Called under rcu_read_lock() from the NTB parsing loop; the skb is
+ * linear, private, and was allocated with XDP_PACKET_HEADROOM.
+ */
+static bool mhi_mbim_xdp_rx(struct mhi_mbim_link *link,
+			    struct bpf_prog *xdp_prog, struct sk_buff *skbn)
+{
+	void *orig_data, *orig_data_end;
+	struct xdp_buff xdp;
+	int delta;
+	u32 act;
+
+	/* Oversized frame (jumbo MTU): let it pass unfiltered rather
+	 * than feed XDP a frame layout it does not expect.
+	 */
+	if (skbn->len > PAGE_SIZE - XDP_PACKET_HEADROOM)
+		return true;
+
+	xdp_init_buff(&xdp,
+		      skb_end_offset(skbn) +
+		      SKB_DATA_ALIGN(sizeof(struct skb_shared_info)),
+		      &link->xdp_rxq);
+	xdp_prepare_buff(&xdp, skbn->head, skb_headroom(skbn), skbn->len,
+			 true);
+	orig_data = xdp.data;
+	orig_data_end = xdp.data_end;
+
+	act = bpf_prog_run_xdp(xdp_prog, &xdp);
+
+	switch (act) {
+	case XDP_PASS:
+	case XDP_TX:
+		/* Propagate head/tail adjustments back to the skb */
+		delta = orig_data - xdp.data;
+		if (delta > 0)
+			skb_push(skbn, delta);
+		else if (delta < 0)
+			skb_pull(skbn, -delta);
+		delta = xdp.data_end - orig_data_end;
+		if (delta > 0)
+			skb_put(skbn, delta);
+		else if (delta < 0)
+			__skb_trim(skbn, skbn->len + delta);
+		skb_metadata_set(skbn, xdp.data - xdp.data_meta);
+
+		if (act == XDP_PASS)
+			return true;
+
+		/* XDP_TX: reflect back out this interface. Goes through
+		 * dev_queue_xmit so the egress qdisc still applies.
+		 */
+		skbn->dev = link->ndev;
+		dev_queue_xmit(skbn);
+		return false;
+	case XDP_REDIRECT:
+		/* Not implemented (would bypass the qdisc/shaper anyway) */
+		fallthrough;
+	default:
+		bpf_warn_invalid_xdp_action(link->ndev, xdp_prog, act);
+		fallthrough;
+	case XDP_ABORTED:
+		trace_xdp_exception(link->ndev, xdp_prog, act);
+		fallthrough;
+	case XDP_DROP:
+		u64_stats_update_begin(&link->rx_syncp);
+		u64_stats_inc(&link->rx_errors);
+		u64_stats_update_end(&link->rx_syncp);
+		dev_kfree_skb_any(skbn);
+		return false;
+	}
+}
+
+static int mhi_mbim_xdp_set(struct net_device *ndev, struct bpf_prog *prog)
+{
+	struct mhi_mbim_link *link = wwan_netdev_drvpriv(ndev);
+	struct bpf_prog *old;
+
+	old = rcu_replace_pointer(link->xdp_prog, prog,
+				  lockdep_rtnl_is_held());
+	if (old)
+		bpf_prog_put(old);
+
+	return 0;
+}
+
+static int mhi_mbim_ndo_bpf(struct net_device *ndev, struct netdev_bpf *bpf)
+{
+	switch (bpf->command) {
+	case XDP_SETUP_PROG:
+		return mhi_mbim_xdp_set(ndev, bpf->prog);
+	default:
+		return -EINVAL;
+	}
+}
