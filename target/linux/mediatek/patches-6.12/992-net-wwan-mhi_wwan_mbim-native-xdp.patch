+/* Raw-IP framing: the first nibble of the datagram selects the L3
+ * protocol. Returns 0 (unknown) for anything else.
+ */
+static __be16 mhi_mbim_ip_proto(const struct sk_buff *skb)
+{
+	switch (skb->data[0] & 0xf0) {
+	case 0x40:
+		return htons(ETH_P_IP);
+	case 0x60:
+		return htons(ETH_P_IPV6);
+	default:
+		return 0;
+	}
+}
+
+/* Run the attached XDP program on one de-aggregated datagram.
+ * Returns true if the skb should continue to the stack (XDP_PASS),
+ * false if it was consumed (dropped or reflected).
+ * Called under rcu_read_lock() from the NTB parsing loop; the skb is
+ * linear, private, and was allocated with XDP_PACKET_HEADROOM.
+ */
+static bool mhi_mbim_xdp_rx(struct mhi_mbim_link *link,
+			    struct bpf_prog *xdp_prog, struct sk_buff *skbn)
+{
+	struct bpf_net_context __bpf_net_ctx, *bpf_net_ctx;
+	void *orig_data, *orig_data_end;
+	struct xdp_buff xdp;
+	int delta;
+	u32 act;
+
+	/* Oversized frame (jumbo MTU): let it pass unfiltered rather
+	 * than feed XDP a frame layout it does not expect.
+	 */
+	if (skbn->len > PAGE_SIZE - XDP_PACKET_HEADROOM)
+		return true;
+
+	xdp_init_buff(&xdp,
+		      skb_end_offset(skbn) +
+		      SKB_DATA_ALIGN(sizeof(struct skb_shared_info)),
+		      &link->xdp_rxq);
+	xdp_prepare_buff(&xdp, skbn->head, skb_headroom(skbn), skbn->len,
+			 true);
+	orig_data = xdp.data;
+	orig_data_end = xdp.data_end;
+
+	/* Establish the per-task bpf_net_context that the redirect
+	 * helpers reach for. bpf_net_ctx_get_ri() dereferences
+	 * current->bpf_net_context with no NULL check, and the core only
+	 * sets one up in net_rx_action(), napi_threaded_poll_loop(),
+	 * __napi_busy_loop(), busy_poll_stop(), sch_handle_ingress(),
+	 * sch_handle_egress(), cpu_map_bpf_prog_run() and run_lwt_bpf().
+	 * This hook runs from the MHI DL tasklet, which is none of them,
+	 * so without this any attached program that calls
+	 * bpf_redirect_map() and friends -- e.g. libxdp's xsk_def_prog,
+	 * which every `xdp-loader load` of an AF_XDP program installs --
+	 * faults reading NULL + offsetof(struct bpf_redirect_info,
+	 * kern_flags) on the first datagram received. Nesting-safe:
+	 * bpf_net_ctx_set() returns NULL when a context is already active
+	 * and bpf_net_ctx_clear(NULL) is a no-op. Cleared before the
+	 * XDP_TX dev_queue_xmit() below, so egress tc establishes its own.
+	 */
+	bpf_net_ctx = bpf_net_ctx_set(&__bpf_net_ctx);
+	act = bpf_prog_run_xdp(xdp_prog, &xdp);
+	bpf_net_ctx_clear(bpf_net_ctx);
+
+	switch (act) {
+	case XDP_PASS:
+	case XDP_TX:
+		/* Propagate head/tail adjustments back to the skb */
+		delta = orig_data - xdp.data;
+		if (delta > 0)
+			skb_push(skbn, delta);
+		else if (delta < 0)
+			skb_pull(skbn, -delta);
+		delta = xdp.data_end - orig_data_end;
+		if (delta > 0)
+			skb_put(skbn, delta);
+		else if (delta < 0)
+			__skb_trim(skbn, skbn->len + delta);
+		skb_metadata_set(skbn, xdp.data - xdp.data_meta);
+
+		if (act == XDP_PASS)
+			return true;
+
+		/* XDP_TX: reflect back out this interface via
+		 * dev_queue_xmit so the egress qdisc still applies. This
+		 * skb never went through the RX stack, which is what
+		 * normally calls skb_reset_network_header() and sets
+		 * skb->protocol. Without both, cake_handle_diffserv()
+		 * sees protocol 0 and a bogus network offset, so every
+		 * reflected packet lands in besteffort with its DSCP
+		 * ignored.
+		 */
+		skb_reset_network_header(skbn);
+		skbn->protocol = mhi_mbim_ip_proto(skbn);
+		skbn->dev = link->ndev;
+		dev_queue_xmit(skbn);
+		return false;
+	case XDP_REDIRECT:
+		/* Not implemented, and not merely as policy: these skbs are
+		 * kmalloc-backed, so xdp_convert_buff_to_frame() would hand
+		 * xdp_return_frame() a slab address to page_frag_free() under
+		 * MEM_TYPE_PAGE_SHARED. Doing it properly would mean
+		 * xdp_do_generic_redirect(), which bypasses the egress
+		 * qdisc/shaper anyway.
+		 */
+		fallthrough;
+	default:
+		bpf_warn_invalid_xdp_action(link->ndev, xdp_prog, act);
+		fallthrough;
+	case XDP_ABORTED:
+		/* Program fault or invalid verdict: a genuine RX error. */
+		trace_xdp_exception(link->ndev, xdp_prog, act);
+		u64_stats_update_begin(&link->rx_syncp);
+		u64_stats_inc(&link->rx_errors);
+		u64_stats_update_end(&link->rx_syncp);
+		dev_kfree_skb_any(skbn);
+		return false;
+	case XDP_DROP:
+		/* Deliberate policy drop, not an error: counting it in
+		 * rx_errors makes `ip -s link` show a healthily filtered
+		 * link as faulty. Use the core rx_dropped counter, which
+		 * dev_get_stats() merges on top of ndo_get_stats64() —
+		 * the same thing gro_cells does on its own drop path.
+		 */
+		dev_core_stats_rx_dropped_inc(link->ndev);
+		dev_kfree_skb_any(skbn);
+		return false;
+	}
+}
+
+static int mhi_mbim_xdp_set(struct net_device *ndev, struct bpf_prog *prog)
+{
+	struct mhi_mbim_link *link = wwan_netdev_drvpriv(ndev);
+	struct bpf_prog *old;
+
+	old = rcu_replace_pointer(link->xdp_prog, prog,
+				  lockdep_rtnl_is_held());
+	if (old)
+		bpf_prog_put(old);
+
+	return 0;
+}
+
+static int mhi_mbim_ndo_bpf(struct net_device *ndev, struct netdev_bpf *bpf)
+{
+	switch (bpf->command) {
+	case XDP_SETUP_PROG:
+		return mhi_mbim_xdp_set(ndev, bpf->prog);
+	default:
+		return -EINVAL;
+	}
+}
+
