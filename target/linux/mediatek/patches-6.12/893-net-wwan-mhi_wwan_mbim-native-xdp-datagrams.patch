+static struct sk_buff *mhi_mbim_xdp_skb(struct mhi_mbim_link *link,
+					struct xdp_buff *xdp,
+					unsigned int truesize)
+{
+	struct sk_buff *skbn;
+
+	skbn = build_skb(xdp->data_hard_start, truesize);
+	if (!skbn)
+		return NULL;
+
+	skb_reserve(skbn, xdp->data - xdp->data_hard_start);
+	__skb_put(skbn, xdp->data_end - xdp->data);
+	skbn->dev = link->ndev;
+
+	return skbn;
